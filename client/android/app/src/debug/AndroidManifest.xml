<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (merged over src/main): lets the local-test build (KNIGHTAGE_APP_TARGET=local in
     capacitor.config.ts) load the dev APIs on http://localhost through `adb reverse`. Release builds never
     get this and stay https-only. -->
